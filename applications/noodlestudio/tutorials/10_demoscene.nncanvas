    {
      "id": "shader-1",
      "type": "SHADER_VIS",
      "name": "Plasma Display",
      "position": [
        820,
        150
      ],
      "params": {
        "shader_code": "#version 330 core\nout vec4 FragColor;\nuniform float time;\nuniform vec2 resolution;\nuniform float u_value;\n\nvoid main() {\n    vec2 uv = gl_FragCoord.xy / resolution;\n    \n    // Classic plasma with neural modulation\n    float v = 0.0;\n    v += sin((uv.x + time * 0.5) * 10.0);\n    v += sin((uv.y + time * 0.3) * 10.0);\n    v += sin((uv.x + uv.y + time) * 10.0);\n    v += sin(sqrt(uv.x * uv.x + uv.y * uv.y) * 10.0 + u_value * 6.28);\n    v /= 4.0;\n    \n    // Neural-controlled color cycling\n    vec3 col = vec3(\n        0.5 + 0.5 * sin(v * 3.14159 + u_value * 2.0),\n        0.5 + 0.5 * sin(v * 3.14159 + u_value * 2.0 + 2.0),\n        0.5 + 0.5 * sin(v * 3.14159 + u_value * 2.0 + 4.0)\n    );\n    \n    FragColor = vec4(col, 1.0);\n}",
        "width": 256,
        "height": 256,
        "preset": "custom"
      },
      "inputs": {
        "value": {
          "data_type": "SCALAR",
          "shape": null,
          "required": false,
          "label": "Uniform Value"
        }
      },
      "outputs": {},
      "weights": {},
      "collapsed": false,
      "color": "#00695C",
      "tags": [],
      "description": "GLSL plasma driven by neural signals!"
