  affect:
    type: AffectTransistor
    salience: 0.95
  personality:
    type: PersonalityTransistor
    traits:
      empathy: 0.98
      sensitivity: 0.95
      expressiveness: 0.9
      emotional_control: 0.15
    salience: 0.75
  intuition:
    type: IntuitionTransistor
    salience: 0.8
